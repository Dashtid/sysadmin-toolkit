<?xml version="1.0" encoding="UTF-16"?>
<!--
  Weekly system-updates scheduled task -- XML import alternative.

  RECOMMENDED: Use Install-SystemUpdatesTask.ps1 instead. This XML is provided
  for users who prefer to import via the Task Scheduler GUI.

  Before importing:
    1. Replace REPLACE_USER_SID with the SID of the user who should run the task.
       Get yours via: (New-Object Security.Principal.NTAccount($env:USERNAME)).Translate([Security.Principal.SecurityIdentifier]).Value
    2. Replace REPLACE_TOOLKIT_PATH with the absolute path to your sysadmin-toolkit clone.
    3. Adjust StartBoundary to your preferred first run time.

  Defaults are tuned for laptop dev environments:
    - Runs as user (not SYSTEM) so winget user-scope packages are visible
    - HighestAvailable run level so no UAC prompt is required
    - Battery-friendly: starts and continues on battery
    - StartWhenAvailable catches up a missed weekly slot
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Date>2025-10-15T10:00:00</Date>
    <Author>SystemAdmin</Author>
    <Description>Weekly automated system updates using system-updates.ps1. Updates Chocolatey, Winget, and Windows Update. Creates restore points before updates.</Description>
    <URI>\Maintenance\Weekly System Updates</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2025-10-20T10:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek>
          <Sunday />
        </DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>REPLACE_USER_SID</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>false</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <DisallowStartOnRemoteAppSession>false</DisallowStartOnRemoteAppSession>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT3H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Program Files\PowerShell\7\pwsh.exe</Command>
      <Arguments>-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "REPLACE_TOOLKIT_PATH\Windows\maintenance\system-updates.ps1"</Arguments>
      <WorkingDirectory>REPLACE_TOOLKIT_PATH\Windows\maintenance</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
